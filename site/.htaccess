# hscfdoral.com — Apache settings for the static site (ignored by non-Apache servers)
# Generated by build/build.py. Edit REDIRECTS in build.py, not this file.

ErrorDocument 404 /404.html
Options -Indexes
DirectoryIndex index.html

# Correct file types
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType video/mp4 .mp4
AddType image/webp .webp
AddType application/rss+xml .xml
AddType text/plain .txt
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never serve hidden files (except .well-known)
  RewriteRule "(^|/)\.(?!well-known/)" - [F]

  # Force HTTPS and the bare domain. Turn on only after SSL works on the server,
  # otherwise the site will redirect in a loop. Remove the leading "# " on the 4 lines.
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} ^www\. [NC]
  # RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # The site lives in an addon-domain folder of a shared cPanel account, so the same files can also be
  # reached through the account's other domain names. Send every other host name to hscfdoral.com.
  # (Per-folder pattern: $1 is the path inside this folder.) Switch http to https here with the block above.
  RewriteCond %{HTTP_HOST} !^(www\.)?hscfdoral\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
  RewriteRule ^(.*)$ http://hscfdoral.com/$1 [L,R=301]

  # Old WordPress addresses that moved (most old addresses are unchanged)
  RewriteRule ^contact-us/?$ /contacto/ [L,R=301,NE]
  RewriteRule ^trainings/?$ /cursos-y-talleres/ [L,R=301,NE]
  RewriteRule ^novedades-2/?$ /novedades/ [L,R=301,NE]
  RewriteRule ^mentores/?$ /staff/ [L,R=301,NE]
  RewriteRule ^annette-dallera/?$ /staff/ [L,R=301,NE]
  RewriteRule ^sandra-alvarez/?$ /staff/ [L,R=301,NE]
  RewriteRule ^2021/06/play-therapy-training-module-1/?$ /2021/06/lisa-saldana-presents-play-therapy-training/ [L,R=301,NE]
  RewriteRule ^2021/06/play-therapy-training-module-2/?$ /2021/06/lisa-saldana-presents-play-therapy-training/ [L,R=301,NE]
  RewriteRule ^2021/07/play-therapy-training-working-with-familes-with-play-therapy/?$ /2021/06/lisa-saldana-presents-play-therapy-training/ [L,R=301,NE]
  RewriteRule ^2021/06/capacitacion/?$ /2021/06/lisa-saldana-presents-play-therapy-training/ [L,R=301,NE]
  RewriteRule ^category/.*/?$ /blog/ [L,R=301,NE]
  RewriteRule ^author/.*/?$ /blog/ [L,R=301,NE]
  RewriteRule ^blog/page/[0-9]+/?$ /blog/ [L,R=301,NE]
  RewriteRule ^feed/?$ /blog/feed.xml [L,R=301,NE]
  RewriteRule ^karina-la-banca/?$ /jorge-garcia/ [L,R=301,NE]
  RewriteRule ^maria-cecilia-mauricio-2/?$ /maria-cecilia-mauricio/ [L,R=301,NE]
  RewriteRule ^juan-felipe-diaz-3/?$ /juan-felipe-diaz/ [L,R=301,NE]
  RewriteRule ^silvia-lugo-psicologa-deportiva/?$ /silvia-lugo/ [L,R=301,NE]
  RewriteRule ^alibel-osorio-2/?$ /alibel-osorio/ [L,R=301,NE]
  RewriteRule ^ana-victoria-armenta/?$ /#testimonios [L,R=301,NE]
  RewriteRule ^anonimo/?$ /#testimonios [L,R=301,NE]
  RewriteRule ^claudia-veleizan/?$ /#testimonios [L,R=301,NE]

  # The old WordPress system is gone
  RewriteRule ^(wp-admin|wp-login\.php|wp-content|wp-includes|wp-json|xmlrpc\.php)(/.*)?$ - [G]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/ld+json application/xml application/rss+xml image/svg+xml
</IfModule>

# Caching: pages revalidate, assets cache for a month
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/rss+xml "access plus 1 hour"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
